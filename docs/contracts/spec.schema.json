{
  "$defs": {
    "Approval": {
      "additionalProperties": false,
      "description": "A verdict on a spec version (e.g. from Haki swipe). Times are stored in UTC.",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "decision": {
          "enum": [
            "keep",
            "cut",
            "love"
          ],
          "title": "Decision",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "spec_version": {
          "exclusiveMinimum": 0,
          "title": "Spec Version",
          "type": "integer"
        },
        "who": {
          "maxLength": 64,
          "pattern": "^[a-z]+-[0-9a-z]+$",
          "title": "Who",
          "type": "string"
        }
      },
      "required": [
        "spec_version",
        "who",
        "decision",
        "at",
        "source"
      ],
      "title": "Approval",
      "type": "object"
    },
    "ArtworkElement": {
      "additionalProperties": false,
      "description": "One coloured part of an artwork (a letter, an outline, a fill) and how it is made.",
      "properties": {
        "colour": {
          "anyOf": [
            {
              "$ref": "#/$defs/Colour"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "stitch_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stitch Type"
        },
        "thread": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thread"
        }
      },
      "required": [
        "name"
      ],
      "title": "ArtworkElement",
      "type": "object"
    },
    "Change": {
      "additionalProperties": false,
      "description": "One numbered revision after a sample: what the sample did, what it should do, and why.",
      "properties": {
        "area": {
          "enum": [
            "placement-position",
            "placement-size",
            "pom",
            "hardware",
            "label",
