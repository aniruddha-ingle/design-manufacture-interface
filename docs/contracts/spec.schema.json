        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "image_refs": {
          "items": {
            "type": "string"
          },
          "title": "Image Refs",
          "type": "array"
        },
        "n": {
          "exclusiveMinimum": 0,
          "title": "N",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
