    "Length": {
      "additionalProperties": false,
      "description": "A measured value in mm. ``mm=None`` (and no range) is a gap.\n\n``tol_mm`` is the + tolerance and, unless ``tol_minus_mm`` is set, also the - tolerance.\nAn adjustable dimension (a head circumference with a strap) is a range: ``min_mm``/``max_mm``.",
      "properties": {
        "max_mm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Mm"
        },
        "min_mm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Mm"
        },
        "mm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mm"
        },
        "tol_minus_mm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tol Minus Mm"
        },
        "tol_mm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tol Mm"
        }
      },
      "title": "Length",
      "type": "object"
    },
